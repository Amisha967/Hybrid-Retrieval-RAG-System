# Project Configuration
PROJECT_NAME="Hybrid Retrieval RAG System"

# Vector Store & Embedding Configuration
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
CHROMA_COLLECTION_NAME="hybrid_rag_documents"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"

# Cross-Encoder Reranker
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANKER_DEVICE="cpu"

# BM25 Sparse Index
BM25_PERSIST_PATH="./data/bm25_index.pkl"

# KV Cache & Metrics
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=3600

# LLM Providers (local_extractive, gemini, openai, huggingface)
LLM_PROVIDER="local_extractive"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
HF_MODEL_NAME="google/flan-t5-base"

# Frontend
BACKEND_URL="http://localhost:8000"
